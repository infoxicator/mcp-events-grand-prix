{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-grand-prix-test",
  "main": "e2e-worker/test-entry.ts",
  "vars": {
    "ACCESS_ISSUER": "https://grand-prix-test.cloudflareaccess.com",
    "ACCESS_AUD": "grand-prix-fixture",
    "ACCESS_OWNER_EMAIL": "owner@example.test",
    "TYPESAFE_API_KEY": "fixture-only",
    "AI_GATEWAY_API_KEY": "fixture-only",
    "OPENAI_API_KEY": "fixture-only",
    "SEP_EVENTS_AUTH_TOKEN": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
  },
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/sep-events", "/owner/*", "/health", "/internal*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "ROOM_CREATION",
      "namespace_id": "1794564601",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ,
    {
      "name": "MCP_ROOM_CREATION",
      "namespace_id": "1794564602",
      "simple": {
        "limit": 200,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ]
}

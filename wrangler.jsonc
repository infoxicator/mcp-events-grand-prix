{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1",
  "account_id": "dea6d398d44bb555f31cd3e8c63668f8",
  "preview_urls": false,
  "keep_vars": true,
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/sep-events", "/owner/*", "/health", "/internal*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "ROOM_CREATION",
      "namespace_id": "1794564601",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ,
    {
      "name": "MCP_ROOM_CREATION",
      "namespace_id": "1794564602",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ]
}

# No key? Mock mode is automatic. Force it for recordings/tests:
# JEV_MOCK=1
# Choose one provider. Never prefix keys with VITE_.
# Your own TypeSafe Jev API key (direct):
# JEV_PROVIDER=typesafe
# TYPESAFE_API_KEY=your-typesafe-key
# JEV_MODEL=jev-latest
# Or use OpenRouter:
# JEV_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key
# JEV_MODEL=jev-1.13
# Or use Vercel AI Gateway:
# JEV_PROVIDER=vercel
# AI_GATEWAY_API_KEY=your-gateway-key
# JEV_MODEL=typesafe-ai/jev
# JEV_MOCK=0  # fail startup if no real key, instead of automatic mock mode

# Extra matchup: left Jev versus right GPT-6 Luna (OpenAI Decisions API).
# PONG_MATCHUP=jev-vs-luna
# OPENAI_API_KEY=your-openai-api-key
# LUNA_MOCK=0  # require a real OpenAI key; model is pinned to gpt-6-luna
# LUNA_MOCK=1  # mock only Luna; JEV_MOCK=1 always mocks both players
# LUNA_INTERVAL_MS=600  # minimum pause after each live Luna response
# LUNA_TPM_BUDGET=60000  # app budget; reserves 20% headroom and respects lower provider TPM

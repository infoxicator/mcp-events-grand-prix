# Local server only. Never commit .env.local. Mock mode overrides every provider.
JEV_MOCK=1
ENGINEER_MOCK=1
PORT=5277
RACE_SPEED=4
# Fast Jev driver: choose typesafe, openrouter, or vercel.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# JEV_MODEL=jev-latest
# Slow race engineer: OpenRouter or Vercel AI Gateway chat completions.
# ENGINEER_PROVIDER=openrouter
# ENGINEER_MODEL=openai/gpt-4.1
# To enable live agents, set JEV_MOCK=0 and ENGINEER_MOCK=0 with keys above.

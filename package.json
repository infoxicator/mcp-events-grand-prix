{
  "name": "jev-vs-jev-pong",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build && vite build --config vite.mcp.config.ts && vite build --config vite.mcp-host.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "tsx server/index.ts --production",
    "demo": "node scripts/demo.mjs",
    "test:provider": "tsx scripts/verify-provider.ts",
    "demo:smoke": "node scripts/demo.mjs --smoke",
    "verify": "npm run build && npm test && npm run test:provider && npm run test:luna && npm run test:quota && npm run test:e2e && npm run test:mcp",
    "demo:luna": "node scripts/demo.mjs --matchup=jev-vs-luna",
    "test:luna": "tsx scripts/verify-luna.ts",
    "test:quota": "tsx scripts/verify-quota.ts",
    "mcp:host": "tsx scripts/mcp-host.ts",
    "demo:mcp": "npm run build && tsx scripts/mcp-host.ts --start-game",
    "test:mcp": "tsx scripts/verify-mcp.ts",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:worker": "playwright test --config playwright.worker.config.ts",
    "test:clock": "tsx scripts/verify-clock.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "^4.0.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.0.8",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@typesafe-ai/sdk": "0.7.0",
    "dotenv": "^18.0.10",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}

{
  "name": "jev-grand-prix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build && vite build --config vite.mcp.config.ts && vite build --config vite.mcp-host.config.ts && node scripts/check-asset-budget.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/race.spec.ts e2e/provider-ui.spec.ts e2e/realism.spec.ts e2e/vegas.spec.ts e2e/realism-v2.spec.ts e2e/circuit-review.spec.ts",
    "test:mcp": "playwright test --grep \"MCP\"",
    "test:worker": "playwright test --config playwright.worker.config.ts",
    "start": "node --import tsx server/index.ts --production",
    "demo": "node scripts/demo.mjs",
    "demo:smoke": "node scripts/demo.mjs --smoke",
    "mcp:host": "node --import tsx scripts/mcp-host.ts",
    "demo:mcp": "npm run build && node --import tsx scripts/mcp-host.ts --start-game",
    "verify": "npm run build && npm test && npm run test:e2e && npm run test:mcp",
    "dev:worker": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run --outdir /tmp/jev-grand-prix-worker",
    "test:performance": "node scripts/performance.mjs",
    "demo:luna": "node scripts/demo.mjs --matchup=jev-vs-luna",
    "test:luna": "vitest run __test__/luna.test.ts",
    "demo:realistic": "RACE_SPEED=1 node scripts/demo.mjs",
    "test:handling": "node --import tsx scripts/handling-check.ts && node --import tsx scripts/calibrate.ts",
    "demo:vegas": "RACE_CIRCUIT=las-vegas RACE_SPEED=1 node scripts/demo.mjs",
    "model:build": "/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup --python scripts/blender/build_car.py",
    "circuit:build": "node --import tsx scripts/export-circuit.ts && python3 scripts/blender/circuit_textures.py && /Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup --python scripts/blender/build_circuits.py -- 4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "^4.0.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.0.8",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@typesafe-ai/sdk": "0.7.0",
    "dotenv": "^18.0.10",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
